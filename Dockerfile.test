# Test runner for ThermoSmart Welle 2+ integration tests.
# Requires Linux (homeassistant.runner imports fcntl).
#
# Build & run from project root:
#   docker build -f Dockerfile.test -t thermosmart-test .
#   docker run --rm thermosmart-test
#
# Or without building (volume-mount, faster for iterating):
#   docker run --rm -v "<absolute-project-path>:/app" -w /app python:3.12-slim \
#     bash -c "pip install -r requirements_test.txt -q && \
#              python -m pytest tests/ --override-ini='addopts=' -v --tb=short"

FROM python:3.12-slim

WORKDIR /app
COPY requirements_test.txt .
RUN pip install --no-cache-dir -r requirements_test.txt

COPY . .

# --override-ini='addopts=' clears the Windows-only -p no:homeassistant_custom_component flag
CMD ["python", "-m", "pytest", "tests/", "--override-ini=addopts=", "-v", "--tb=short", "--cov=custom_components/thermosmart", "--cov-report=term-missing"]
